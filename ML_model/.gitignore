datasets/

# =========================
# ML model artifacts
# =========================
# Keep the deployment model in Git: it is required to run inference and is
# below GitHub's 100 MB per-file limit. Ignore only local retraining outputs
# whose names make their generated status explicit.
model/*_local.joblib
model/*_local.pkl
model/*_local.pickle

# =========================
# Runtime/generated models
# =========================
model/*_local_runtime.json

# =========================
# OS / IDE
# =========================
.DS_Store
.vscode/
.idea/

# =========================
# Logs
# =========================
*.log

# =========================
# Environment variables
# =========================
.env
.env.*

# =========================
# Temporary files
# =========================
*.tmp
*.temp
